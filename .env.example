# Postgres connection string. Locally, any Postgres instance works. In
# production, use Supabase's pooled connection (port 6543, pgbouncer=true).
DATABASE_URL="postgresql://user:pass@localhost:5432/mindmatrix_dev?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Public CliQ payment details shown to students at checkout. These are not
# secrets, but must exactly match the center's real bank-registered CliQ
# alias, or students will send money to the wrong place.
NEXT_PUBLIC_CLIQ_ALIAS="MindMatrixAcademy"
NEXT_PUBLIC_CLIQ_BANK_NAME="اسم البنك"
